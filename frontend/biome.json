{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",

	"formatter": {
		"enabled": true
	},

	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noUnknownAtRules": "off"
			}
		}
	},

	"css": {
		"linter": {
			"enabled": true
		}
	},

	"files": {
		"includes": ["**", "!!**/coverage", "!!**/dist", "!!**/node_modules"]
	}
}
